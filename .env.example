# Workload Security — Environment Configuration Template (Datathon 2026)
# Copy this file to .env and customize as needed. Never commit actual secret keys.

# ==============================================================================
# Platform & Mode Settings (Person 1 - Platform Lead)
# ==============================================================================
OFFLINE_MODE=true
SOURCE_HOST=linuxone-node-01
SOURCE_ARCH=s390x

# ==============================================================================
# Ingestion & Privacy Settings (Person 2 - Event Pipeline Engineer)
# ==============================================================================
FORWARDER_MODE=fixture_replay
FIXTURE_PATH=fixtures/sample-tetragon-raw.jsonl
SCHEMA_VERSION=1.0.0
PRIVACY_REDACTION_ENABLED=true
PRIVACY_POLICY=standard
LLM_EXTERNAL_ENRICHMENT_ENABLED=false
DEDUPLICATION_ENABLED=true

# ==============================================================================
# Redis Stream Configuration
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_KEY=security:events
REDIS_MAXLEN=10000
# REDIS_PASSWORD=

# ==============================================================================
# Remediation Safety (Person 3 - Detection & Safety)
# ==============================================================================
# Mandatory safety defaults: always dry-run and human-in-the-loop for Datathon demos
REMEDIATION_DRY_RUN=true
REMEDIATION_AUTONOMY_MODE=human-in-loop
REMEDIATION_SIGKILL_THRESHOLD=0.85
REMEDIATION_YAML_THRESHOLD=0.75

# ==============================================================================
# AI / LLM / RAG Configuration (Optional - Person 3)
# ==============================================================================
# Leave empty unless explicitly running cloud LLM evaluation with redacted telemetry
GOOGLE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
LLM_MODEL=gemini-2.0-flash

# ==============================================================================
# Service Ports (Person 4 - Dashboard & Integration)
# ==============================================================================
API_PORT=8081
DASHBOARD_API_PORT=8080
FRONTEND_PORT=5173